 - (BOOL)application:(UIApplication *)application didFinishLaunchingWithOptions:(NSDictionary *)launchOptions
+{
+    /* With the UIScene life cycle, windows need a scene, which connects after this
+     * returns; SDLUIKitSceneDelegate starts the app then. */
+    if (!SDL_UIKitUsesSceneLifeCycle()) {
+        [self startWithScene:nil];
+    }
+    return YES;
+}
