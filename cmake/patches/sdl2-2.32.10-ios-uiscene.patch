+UIWindowScene *UIKit_GetActiveWindowScene(void)
+{
+    UIWindowScene *fallback = nil;
+    for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+        if (![scene isKindOfClass:[UIWindowScene class]]) {
+            continue;
+        }
+        if (scene.activationState == UISceneActivationStateForegroundActive) {
+            return (UIWindowScene *)scene;
+        }
+        if (!fallback || scene.activationState == UISceneActivationStateForegroundInactive) {
+            fallback = (UIWindowScene *)scene;
+        }
+    }
+    return fallback;
+}
+
+#if !TARGET_OS_TV
+UIInterfaceOrientation UIKit_GetInterfaceOrientation(void)
+{
+    if (@available(iOS 16.0, *)) {
+        UIWindowScene *scene = UIKit_GetActiveWindowScene();
+        if (scene) {
+            return scene.effectiveGeometry.interfaceOrientation;
+        }
+    }
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    return [UIApplication sharedApplication].statusBarOrientation;
+#pragma clang diagnostic pop
+}
+#endif
