+#if !TARGET_OS_TV
+/* iOS 16 and later only ask a view controller for its orientations again once told they changed,
+ * so an app that changes SDL_HINT_ORIENTATIONS at run time (a foldable allowing portrait on its
+ * large screen only) has to say so. iOS then rotates to an allowed orientation if needed. Hint
+ * callbacks run before SDL stores the new value, and iOS asks at once, so tell it on the next
+ * turn of the run loop. */
+static void SDLCALL
+SDL_OrientationsHintChanged(void *userdata, const char *name, const char *oldValue, const char *hint)
+{
+    @autoreleasepool {
+        SDL_uikitviewcontroller *viewcontroller = (__bridge SDL_uikitviewcontroller *) userdata;
+        if (@available(iOS 16.0, *)) {
+            dispatch_async(dispatch_get_main_queue(), ^{
+                [viewcontroller setNeedsUpdateOfSupportedInterfaceOrientations];
+            });
+        }
+    }
+}
+#endif
+
